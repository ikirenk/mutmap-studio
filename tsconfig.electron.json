{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "electron",
    "outDir": "dist-electron",
    "resolveJsonModule": true
  },
  "include": ["electron"],
  "exclude": ["node_modules", "dist", "src"]
}
